generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EpisodeStatus {
  QUEUED
  RUNNING
  PUBLISHED
  FAILED
  CANCELLED
}

enum PlaybackKind {
  play
  progress
}

model User {
  id                           String    @id @default(cuid())
  email                        String    @unique
  supabaseId                   String?   @unique
  stripeCustomerId             String?   @unique
  subscriptionId               String?   @unique
  subscriptionStatus           String?
  subscriptionPriceId          String?
  subscriptionCurrentPeriodEnd DateTime?
  subscriptionCancelAtPeriodEnd Boolean?  // True if user canceled but still has access until period end
  episodeCredits               Int       @default(3)
  createdAt                    DateTime  @default(now())
  feeds                        Feed[]
  episodes                     Episode[]
  usageRecords                 UsageRecord[]
}

model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  episodeId String?
  credits   Int
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// Feed = RSS subscription that shows article previews
model Feed {
  id              String    @id @default(cuid())
  userId          String
  name            String
  feedUrl         String    // The RSS/Atom feed URL
  siteUrl         String?   // The website homepage
  faviconUrl      String?
  latestItemTitle String?
  latestItemUrl   String?
  lastFetchedAt   DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodes        Episode[]

  @@index([userId])
}

// Episode = a generated podcast, can be standalone or from a feed
model Episode {
  id             String        @id @default(cuid())
  userId         String
  feedId         String?       // Optional - null for standalone one-off episodes
  title          String
  sourceUrl      String        // The article URL this came from
  status         EpisodeStatus
  format         String?       // The format used (e.g., "conversational", "solo")
  scriptText     String
  transcriptText String
  chaptersJson   Json
  audioObjectKey String?
  durationSec    Int?
  publicId       String        @unique
  createdAt      DateTime      @default(now())
  publishedAt    DateTime?
  errorMessage   String?
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  feed           Feed?         @relation(fields: [feedId], references: [id], onDelete: SetNull)
  playbackEvents PlaybackEvent[]

  @@index([userId])
  @@index([feedId])
  @@index([status])
  // Compound index for listing episodes by feed sorted by date
  @@index([feedId, createdAt])
  // Compound index for user dashboard queries
  @@index([userId, createdAt])
}

model PlaybackEvent {
  id        String       @id @default(cuid())
  episodeId String
  kind      PlaybackKind
  value     Int?
  createdAt DateTime     @default(now())
  ua        String?
  referrer  String?
  episode   Episode      @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId])
  @@index([createdAt])
  // Compound index for analytics queries that filter by episode and time range
  @@index([episodeId, createdAt])
}
